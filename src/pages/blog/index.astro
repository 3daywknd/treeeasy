---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getBreadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const title = 'Tree Care Blog | Tree Easy — Ogden & Weber County';
const description =
  'Practical tree care advice for Ogden and Weber County homeowners: seasonal guides, common problems, and when to call a pro. From Tree Easy.';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/blog/"
  schemas={[getBreadcrumbSchema(trail)]}
>
  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <h1>Tree Care Blog</h1>
      <p class="lede">
        Straight, practical advice for keeping Weber County trees healthy and safe — from the crew
        that works on them.
      </p>
    </div>
  </section>

  <Breadcrumbs trail={trail} />

  <section class="prose">
    <div class="wrap">
      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <h2>{post.data.title}</h2>
              </a>
              <p class="post-meta">{fmt(post.data.pubDate)}</p>
              <p>{post.data.description}</p>
              <a class="card-link" href={`/blog/${post.id}/`}>
                Read more →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
