---
import { business } from '../data/business';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Site-relative path, e.g. "/services/tree-removal/". Used for canonical + og:url. */
  canonicalPath: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** JSON-LD nodes to emit in <head>. Each rendered as its own script tag. */
  schemas?: Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogImage = `${business.url}/og-image.jpg`,
  schemas = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;

if (import.meta.env.DEV && description.length > 165) {
  console.warn(
    `[seo] meta description is ${description.length} chars (>165) on ${canonicalPath} — will truncate in SERPs.`
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name} — Ogden tree care`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#2f5135" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
