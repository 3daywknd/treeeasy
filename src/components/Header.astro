---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import { primaryNav } from '../lib/nav';
import CallButton from './CallButton.astro';
import logo from '../assets/tree-easy-logo.png';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href !== '/' && currentPath.startsWith(href.replace(/#.*$/, ''));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${business.name} home`}>
      <Image src={logo} alt="Tree Easy logo" width={56} height={56} densities={[1, 2]} format="webp" />
      <span class="brand-text">
        <span class="brand-name">{business.name}</span>
        <span class="brand-tag">{business.tagline}</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <CallButton variant="header" labelSpan={true} ariaLabel={business.phoneAria} />

    <details class="nav-toggle">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
          ><path
            d="M4 6h16M4 12h16M4 18h16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path></svg
        >
        <span>Menu</span>
      </summary>
      <ul class="nav-toggle-menu">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>
