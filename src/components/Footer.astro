---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import { footerColumns } from '../lib/nav';
import logo from '../assets/tree-easy-logo.png';

const year = new Date().getFullYear();
const addressLine = business.address.streetAddress
  ? `${business.address.streetAddress}, ${business.address.locality}, ${business.address.region}`
  : `${business.address.locality}, ${business.address.region}`;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-cols">
      <div class="footer-brand-col">
        <div class="footer-brand">
          <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} format="webp" />
          <span>{business.name}</span>
        </div>
        <p class="footer-nap">{addressLine} · Serving all of Weber County</p>
        <a class="footer-phone" href={business.phoneHref}>{business.phoneDisplay}</a>
        <p class="footer-hours">{business.hoursDisplay}</p>
        {business.licenseNumber && <p class="footer-license">Licensed &amp; insured · Lic. #{business.licenseNumber}</p>}
      </div>

      {
        footerColumns.map((col) => (
          <nav class="footer-col" aria-label={col.heading}>
            <h2 class="footer-heading">{col.heading}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2 class="footer-heading">Connect</h2>
        <ul>
          <li>
            <a
              class="ig-link"
              href={business.social.instagram}
              target="_blank"
              rel="noopener"
              aria-label={`${business.name} on Instagram (${business.social.instagramHandle})`}
            >
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.3 2.3.4.6.2 1 .5 1.5 1 .5.5.8.9 1 1.5.2.5.4 1.1.4 2.3.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.9-.4 2.3-.2.6-.5 1-1 1.5s-.9.8-1.5 1c-.5.2-1.1.4-2.3.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.3-2.3-.4-.6-.2-1-.5-1.5-1s-.8-.9-1-1.5c-.2-.5-.4-1.1-.4-2.3-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.3-1.9.4-2.3.2-.6.5-1 1-1.5s.9-.8 1.5-1c.5-.2 1.1-.4 2.3-.4 1.3-.1 1.6-.1 4.8-.1zm0 2.2c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 3s0 1.8.1 3c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-3s0-1.8-.1-3c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.3a4.3 4.3 0 1 1 0 8.6 4.3 4.3 0 0 1 0-8.6zm0 2.2a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2zm5.5-2.4a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"
                ></path></svg
              >
              <span>{business.social.instagramHandle}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="footer-copy">© {year} {business.name}. All rights reserved.</p>
  </div>
</footer>
