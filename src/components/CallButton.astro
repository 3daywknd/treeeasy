---
/**
 * Click-to-call button. The phone number comes from business.ts — change it in
 * ONE place. Variants reproduce the original hand-coded buttons exactly.
 */
import { business } from '../data/business';

interface Props {
  variant?: 'header' | 'primary' | 'ghost';
  size?: 'lg' | 'xl';
  label?: string;
  icon?: boolean;
  /** Wrap the label in a <span> (header uses this to hide the number under 520px). */
  labelSpan?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size,
  label = business.phoneDisplay,
  icon = true,
  labelSpan = false,
  ariaLabel,
  class: extraClass,
} = Astro.props;

const variantClass =
  variant === 'header' ? 'btn-call header-call' : variant === 'ghost' ? 'btn-ghost' : 'btn-primary';
const sizeClass = size === 'lg' ? 'btn-lg' : size === 'xl' ? 'btn-xl' : '';
const classes = ['btn', variantClass, sizeClass, extraClass].filter(Boolean).join(' ');
---

<a class={classes} href={business.phoneHref} aria-label={ariaLabel}>
  {
    icon && (
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.9.6a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.4a1 1 0 0 1 1 1c0 1.4.2 2.7.6 3.9.1.4 0 .8-.2 1.1l-2.2 2.2z" />
      </svg>
    )
  }
  {labelSpan ? <span>{label}</span> : label}
</a>
